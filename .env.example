# ──────────────────────────────────────────────────────────────────
# 剪映 AI 自动剪辑插件 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ──────────────────────────────────────────────────────────────────

# ── 剪映路径 ─────────────────────────────────────────────────────
# 剪映安装路径 (留空自动检测)
JIANYING_PATH=

# 剪映草稿目录
JIANYING_DRAFT_DIR=C:\Users\%USERNAME%\AppData\Local\JianyingPro\User Data\Projects\com.lveditor.draft

# ── AI 服务配置 ──────────────────────────────────────────────────

# 豆包 (火山引擎方舟平台) — 默认
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-pro-32k

# OpenAI (GPT-4 / Whisper)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_ASR_MODEL=whisper-1

# 通义千问 (DashScope)
DASHSCOPE_API_KEY=sk-your-dashscope-key
QWEN_MODEL=qwen-max

# Ollama (本地部署)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── ASR 配置 ─────────────────────────────────────────────────────
# 提供商: openai / dashscope / faster_whisper
ASR_PROVIDER=openai
ASR_LANGUAGE=zh

# faster-whisper 本地模型路径 (仅 faster_whisper 模式)
FASTER_WHISPER_MODEL=large-v3
FASTER_WHISPER_DEVICE=cuda
FASTER_WHISPER_COMPUTE_TYPE=float16

# ── LLM 配置 ─────────────────────────────────────────────────────
# 提供商: doubao / openai / qwen / ollama
LLM_PROVIDER=doubao
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ── 流水线配置 ───────────────────────────────────────────────────
# 并发数
PIPELINE_MAX_CONCURRENCY=3

# 超时设置 (秒)
STAGE_TIMEOUT=300

# 检查点目录
CHECKPOINT_DIR=.checkpoints

# ── FFmpeg ───────────────────────────────────────────────────────
# FFmpeg 路径 (留空使用系统 PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# ── 日志 ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/jy_auto_editor.log

# ── Web UI (可选) ────────────────────────────────────────────────
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# WEB_SECRET_KEY=your-secret-key
